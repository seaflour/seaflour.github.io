{% from "components/byline.njk" import byline %}
<ol reversed class="post-list" style="--post-list-index: {{ (postListCounter or postList.length) + 1 }}">
{% for post in postList %}
	<li class="post-list-item{% if post.url == url %} post-list-item-active{% endif %}">
		<a href="{{ post.url }}" class="post-list-link">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
		<!--
		<time class="post-list-date" datetime="{{ post.date | formatDateHtml }}">{{ post.date | formatDateDisplay }}</time>
		-->
		{{ byline(site.name, post.data.date, post.data.changed_date, post.data.coauthor, post.data.tags) }}
		<span class="lead"><strong>{{ post.data.description }}</strong></span>
	</li>
{% endfor %}
</ol>
